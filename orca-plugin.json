{
  "manifestVersion": 1,
  "id": "gateway",
  "publisher": "wikivibe",
  "name": "WikiVibe Gateway",
  "version": "1.0.1",
  "description": "Подключает WikiVibe к Orca и записывает выбранную модель в нативные конфигурации поддержанных агентов после предварительного просмотра и явного согласия.",
  "engines": { "orca": ">=1.4.214" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "commands": [
      { "id": "configure", "title": "WikiVibe: Настроить" },
      { "id": "check", "title": "WikiVibe: Проверить подключение" },
      { "id": "disconnect", "title": "WikiVibe: Удалить сохранённый ключ" }
    ]
  },
  "capabilities": [
    { "kind": "secrets" },
    { "kind": "storage" },
    { "kind": "notifications:show" }
  ]
}
