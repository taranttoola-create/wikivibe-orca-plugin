{
  "manifestVersion": 1,
  "id": "gateway",
  "publisher": "wikivibe",
  "name": "WikiVibe Gateway",
  "version": "1.0.2",
  "description": "Видимая панель WikiVibe в Orca: регистрация, защищённое подключение API-ключа и настройка моделей для поддержанных агентов.",
  "engines": { "orca": ">=1.4.214" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [
      { "id": "settings", "title": "WikiVibe", "icon": "plug", "entry": "panel.html" }
    ],
    "commands": [
      { "id": "configure", "title": "WikiVibe: Открыть защищённую настройку" },
      { "id": "check", "title": "WikiVibe: Проверить подключение" },
      { "id": "disconnect", "title": "WikiVibe: Удалить сохранённый ключ" }
    ]
  },
  "capabilities": [
    { "kind": "secrets" },
    { "kind": "storage" },
    { "kind": "notifications:show" }
  ]
}
