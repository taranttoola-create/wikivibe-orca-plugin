{
  "manifestVersion": 1,
  "id": "gateway",
  "publisher": "wikivibe",
  "name": "WikiVibe Gateway",
  "version": "1.1.2",
  "description": "Подключение провайдера WikiVibe с моделями доступными API-ключу, защищённое хранение ключа и обратимая настройка агентов.",
  "engines": { "orca": ">=1.4.214" },
  "pluginApi": 1,
  "main": "main.mjs",
  "icon": "ui/wikivibe-logo.webp",
  "contributes": {
    "panels": [
      { "id": "settings", "title": "WikiVibe", "icon": "star", "entry": "panel.html" }
    ],
    "commands": [
      { "id": "register", "title": "WikiVibe: Открыть WikiVibe и зарегистрироваться" },
      { "id": "configure", "title": "WikiVibe: Открыть защищённую настройку" },
      { "id": "check", "title": "WikiVibe: Проверить подключение" },
      { "id": "disconnect", "title": "WikiVibe: Удалить сохранённый ключ" }
    ]
  },
  "capabilities": [
    { "kind": "secrets" },
    { "kind": "storage" },
    { "kind": "notifications:show" }
  ]
}
