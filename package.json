{
  "name": "wikivibe-orca-plugin",
  "version": "1.1.8",
  "private": true,
  "description": "WikiVibe Gateway для Orca: каталог моделей и обратимая настройка нативных конфигураций семи агентов.",
  "homepage": "https://github.com/taranttoola-create/wikivibe-orca-plugin#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/taranttoola-create/wikivibe-orca-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/taranttoola-create/wikivibe-orca-plugin/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "orca-plugin.json",
    "main.mjs",
    "src",
    "ui",
    "panel.html",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "vendor": "esbuild node_modules/jsonc-parser/lib/esm/main.js node_modules/yaml/browser/index.js --bundle --format=esm --platform=node --outdir=src/vendor --minify --legal-comments=inline",
    "package:plugin": "node scripts/package.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsonc-parser": "3.3.1",
    "yaml": "2.8.1"
  }
}
